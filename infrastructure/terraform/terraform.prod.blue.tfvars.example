# Production (BLUE) stack example.
# Copy to terraform.prod.blue.tfvars and adjust values locally (do NOT commit real tfvars).
env      = "prod"
stack_id = "blue"

server_type = "cx23"
image       = "ubuntu-24.04"
location    = "hel1"

# Name of the SSH key uploaded in Hetzner (not the private key itself).
ssh_key_name = "realestate-prod-ssh-key"

legacy_enabled = false

# Load Balancer is a stable public entrypoint.
# Owner stack is responsible for creating/managing the shared LB resource.
# Target stack defines where traffic is routed right now (blue or green).
load_balancer_owner_stack  = "blue"
load_balancer_target_stack = "blue"

# Enable Kubernetes (k3s) nodes in this stack
k8s_enabled       = true
k3s_server_count  = 1
k3s_workers_count = 1
k3s_api_port      = 6443

# Private networking (this stack)
k3s_network_ip_range = "10.50.0.0/16"
k3s_subnet_ip_range  = "10.50.1.0/24"
k3s_network_zone     = "eu-central"

# Blue/Green: whether to provision green stack in parallel from the blue workspace.
enable_green_stack      = true
k3s_workers_count_green = 0

# Private networking for the parallel GREEN stack (only used when enable_green_stack=true)
k3s_network_ip_range_green = "10.51.0.0/16"
k3s_subnet_ip_range_green  = "10.51.1.0/24"
k3s_network_zone_green     = "eu-central"
