http://realestateproject.casa, http://www.realestateproject.casa {
  handle /lb-health {
    respond "ok" 200
  }

  # everything else -> HTTPS to non-www
  handle {
    redir https://realestateproject.casa{uri} 308
  }
}

# HTTPS (port 443): basic traffic
https://realestateproject.casa, https://www.realestateproject.casa {
  tls zyabrina95@gmail.com
  encode gzip

  # redirect from www
  @www host www.realestateproject.casa
  handle @www {
    redir https://realestateproject.casa{uri} 308
  }

  handle /lb-health {
    respond "ok" 200
  }

  handle /api/* {
    reverse_proxy backend:5000
  }

  # everything else -> frontend
  handle {
    reverse_proxy frontend:80
  }
}
