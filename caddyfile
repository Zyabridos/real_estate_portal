# Catch-all HTTP (works for Host = server IP, required for Hetzner LB health checks)
:80 {
  handle /lb-health {
    respond "ok" 200
  }

  # everything else -> HTTPS to non-www (domain)
  handle {
    redir https://realestateproject.casa{uri} 308
  }
}

# HTTPS (port 443): real traffic
realestateproject.casa, www.realestateproject.casa {
  tls zyabrina95@gmail.com
  encode gzip

  @www host www.realestateproject.casa
  handle @www {
    redir https://realestateproject.casa{uri} 308
  }

  handle /lb-health {
    respond "ok" 200
  }

  handle /api/* {
    reverse_proxy backend:5000
  }

  handle {
    reverse_proxy frontend:80
  }
}
