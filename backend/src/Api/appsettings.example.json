{
  "App": {
    "Name": "RealEstate.Api",
    "Environment": "Development",
    "BaseUrl": "http://localhost:5000"
  },
  "Mongo": {
    "ConnectionString": "mongodb://user:password@localhost:99666/?authSource=admin",
    "Database": "database_name"
  },
  "Jwt": {
    "Issuer": "RealEstatePortal",
    "Audience": "RealEstatePortal.Client",
    "SigningKey": "super-secret-key-change-me-12345",
    "AccessTokenMinutes": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
